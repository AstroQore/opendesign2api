# Local listen. Keep loopback unless you intentionally put another gateway in front.
OPENDESIGN2API_HOST=127.0.0.1
OPENDESIGN2API_PORT=8792

# Recommended local bridge key. It is not the OpenDesign runtime key.
# Generate one with: openssl rand -hex 32
OPENDESIGN2API_KEY=

# Official vela profile / config. Defaults match the desktop app.
OPENDESIGN2API_PROFILE=prod
OPENDESIGN2API_CONFIG=

# Docker Compose bind-mount source. Must be an absolute host path.
OPENDESIGN2API_CONFIG_FILE=

# Optional image pin. Use a release tag or digest in production.
OPENDESIGN2API_IMAGE=ghcr.io/astroqore/opendesign2api:latest

# Optional safety limits.
OPENDESIGN2API_UPSTREAM_TIMEOUT=600
OPENDESIGN2API_MAX_REQUEST_BYTES=8388608
OPENDESIGN2API_CLIENT_TIMEOUT=30
